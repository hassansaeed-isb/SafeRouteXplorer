{
    "name": "SafeRouteXplorer",
    "short_name": "SafeRoute",
    "description": "A progressive web app for safe route exploration.",
    "start_url": "/",
    "display": "standalone",
    "background_color": "#ffffff",
    "theme_color": "#007bff",
    "icons": [{
        "src": "/static/assets/images/srx-logo-192.png",
        "sizes": "192x192",
        "type": "image/png"
    }],
    "service_worker": {
        "src": "/css/sw.js",
        "scope": "/",
        "update_via_cache": "all"
    },
    "screenshots": [{
        "src": "/static/assets/images/image-wide.png",
        "sizes": "1280x720",
        "type": "image/png",
        "form_factor": "wide"
    },
    {
        "src": "/static/assets/images/image-narrow.png",
        "sizes": "1080x1920",
        "type": "image/png",
        "form_factor": "narrow"
    }],
    "id": "/"

}